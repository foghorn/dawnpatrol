# DawnPatrol configuration. Copy to .env and fill in.
#
# Every secret below also accepts a _FILE variant pointing at a file, for
# Docker/Podman secrets:  DAWNPATROL_SOURCE_PIHOLE_PASSWORD_FILE=/run/secrets/pihole
# The _FILE form wins when both are set.

# ─── Schedule ──────────────────────────────────────────────────────────
# Cron expression. Empty = run once and exit (useful for external schedulers).
DAWNPATROL_SCHEDULE=0 6 * * *
DAWNPATROL_TZ=UTC
DAWNPATROL_RUN_ON_START=true
# How far back each run looks. Sources with shorter retention clamp themselves.
DAWNPATROL_WINDOW_HOURS=24
# Spread load if you run several instances.
DAWNPATROL_SCHEDULE_JITTER_SECONDS=0

# ─── Paths ─────────────────────────────────────────────────────────────
DAWNPATROL_DATA_DIR=/var/lib/dawnpatrol
DAWNPATROL_OUTPUT_DIR=/out
DAWNPATROL_PROFILE=/etc/dawnpatrol/profile.yml
DAWNPATROL_LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────────
# Default is SQLite inside DAWNPATROL_DATA_DIR - nothing to configure.
# Setting BOTH a host and a user switches to MySQL automatically.
#DAWNPATROL_DB_HOST=10.0.0.20
#DAWNPATROL_DB_PORT=3306
#DAWNPATROL_DB_NAME=dawnpatrol
#DAWNPATROL_DB_USER=dawnpatrol
#DAWNPATROL_DB_PASSWORD=
# Or specify a full SQLAlchemy URL, which overrides the above:
#DAWNPATROL_DB_URL=mysql+pymysql://user:pass@host:3306/dawnpatrol?charset=utf8mb4

# Retention. Raw events are bulky and short-lived; the narrow IOC slice is
# small and long-lived, and is what makes retrospective hunting possible.
DAWNPATROL_RETENTION_RAW_DAYS=7
DAWNPATROL_RETENTION_IOC_DAYS=180
DAWNPATROL_RETENTION_METRICS_DAYS=730
DAWNPATROL_ENRICHMENT_CACHE_DAYS=14

# ─── AI provider ───────────────────────────────────────────────────────
DAWNPATROL_AI_ENABLED=true
DAWNPATROL_AI_PROVIDER=anthropic
DAWNPATROL_AI_MODEL=claude-opus-5
DAWNPATROL_AI_API_KEY=
# low | medium | high | xhigh | max - the first lever to reach for on cost.
DAWNPATROL_AI_EFFORT=high
DAWNPATROL_AI_MAX_TOKENS=16000
DAWNPATROL_AI_MAX_TOOL_CALLS=25
DAWNPATROL_AI_MAX_TURNS=30
# Hard ceiling. Tripping it degrades to a statistics-only report, never no report.
DAWNPATROL_AI_MAX_COST_USD=3.00
# Advisory token budget the model paces itself against. 0 disables; min 20000.
DAWNPATROL_AI_TASK_BUDGET_TOKENS=0
# Falls back to another model if a safety classifier declines the request.
DAWNPATROL_AI_REFUSAL_FALLBACK=true

# --- Local / OpenAI-compatible models (Ollama, LM Studio, vLLM, LiteLLM) ---
# DAWNPATROL_AI_PROVIDER=openai_compatible
# DAWNPATROL_AI_BASE_URL=http://10.0.0.30:11434     # /v1 is appended if absent
# DAWNPATROL_AI_MODEL=qwen2.5:32b
# DAWNPATROL_AI_API_KEY=                            # often unused locally
# DAWNPATROL_AI_TEMPERATURE=0.2
# DAWNPATROL_AI_TIMEOUT=300
# DAWNPATROL_AI_PRICE_IN=0.0                        # for cost accounting only
# DAWNPATROL_AI_PRICE_OUT=0.0

# ─── Sources ───────────────────────────────────────────────────────────
# A source enables itself when all of its variables are present.

# LibreNMS syslog (firewall + router events)
DAWNPATROL_SOURCE_LIBRENMS_URL=http://librenms.example/api/v0
DAWNPATROL_SOURCE_LIBRENMS_TOKEN=
# Device ids to pull, first is treated as primary. No default: guessing an id
# silently produces a confident report about the wrong device.
DAWNPATROL_SOURCE_LIBRENMS_DEVICES=3,4,7
DAWNPATROL_SOURCE_LIBRENMS_TIMEOUT=60
DAWNPATROL_SOURCE_LIBRENMS_VERIFY_TLS=true

# Pi-hole v6 DNS
DAWNPATROL_SOURCE_PIHOLE_URL=http://pihole.example/api
DAWNPATROL_SOURCE_PIHOLE_PASSWORD=
DAWNPATROL_SOURCE_PIHOLE_TIMEOUT=120
DAWNPATROL_SOURCE_PIHOLE_VERIFY_TLS=false
# FTL's in-memory query log is usually ~24h. Raise only if yours retains more.
DAWNPATROL_SOURCE_PIHOLE_MAX_WINDOW_HOURS=24

# ─── Enrichment ────────────────────────────────────────────────────────
DAWNPATROL_ENRICHMENT_ENABLED=true
#DAWNPATROL_ENRICH_ABUSEIPDB_KEY=
DAWNPATROL_ENRICH_ABUSEIPDB_BUDGET=25
DAWNPATROL_ENRICH_ABUSEIPDB_MAX_AGE_DAYS=90
#DAWNPATROL_ENRICH_ISMALICIOUS_KEY=
DAWNPATROL_ENRICH_ISMALICIOUS_BUDGET=15

# ─── Outputs ───────────────────────────────────────────────────────────
# Per-output policy: ALWAYS | NEVER | IMPORTANT | a status list (AMBER,RED).
# IMPORTANT means AMBER/RED, a failed canary, or an unhealthy source.

# Files (always on, no configuration required)
DAWNPATROL_OUTPUT_FILE_FORMATS=plaintext,json

# Email - daily by default, because silence is indistinguishable from a dead agent.
#DAWNPATROL_OUTPUT_SMTP_HOST=smtp.example.com
#DAWNPATROL_OUTPUT_SMTP_PORT=587
#DAWNPATROL_OUTPUT_SMTP_FROM=dawnpatrol@example.com
#DAWNPATROL_OUTPUT_SMTP_TO=you@example.com
#DAWNPATROL_OUTPUT_SMTP_USERNAME=
#DAWNPATROL_OUTPUT_SMTP_PASSWORD=
#DAWNPATROL_OUTPUT_SMTP_STARTTLS=true
#DAWNPATROL_OUTPUT_SMTP_SSL=false
DAWNPATROL_OUTPUT_SMTP_RUN_WHEN=ALWAYS
# To receive mail only when something matters:
#DAWNPATROL_OUTPUT_SMTP_RUN_WHEN=IMPORTANT

# Webhook (ntfy, Slack, Discord, Home Assistant). Important-only by default.
#DAWNPATROL_OUTPUT_WEBHOOK_URL=
#DAWNPATROL_OUTPUT_WEBHOOK_TOKEN=
#DAWNPATROL_OUTPUT_WEBHOOK_STYLE=json          # json | text | slack
DAWNPATROL_OUTPUT_WEBHOOK_RUN_WHEN=IMPORTANT

# ─── Detection self-test ───────────────────────────────────────────────
# Injects synthetic activity each run and asserts it was detected. A failed
# canary is a CRITICAL finding: it means a GREEN report proves nothing.
DAWNPATROL_CANARY_ENABLED=true
DAWNPATROL_CANARY_EVERY_N_RUNS=1

# ─── Plugin selection (optional) ───────────────────────────────────────
# Plugins self-enable from their environment. These pin an explicit set.
#DAWNPATROL_SOURCES=librenms_syslog,pihole_dns
#DAWNPATROL_ANALYZERS=
#DAWNPATROL_ENRICHERS=
#DAWNPATROL_OUTPUTS=file,smtp
#DAWNPATROL_DISABLE=
